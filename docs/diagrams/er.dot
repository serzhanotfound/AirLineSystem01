digraph G {
graph [rankdir=LR, bgcolor="white", fontname="DejaVu Sans", fontsize=20, labelloc=t, nodesep=0.35, ranksep=0.8, label="Airline — PostgreSQL tables (revision 3)"];
node [shape=record, fontname="DejaVu Sans", fontsize=11, style=filled, fillcolor="#edf4ff", color="#5375a5", margin="0.12,0.08"];
edge [fontname="DejaVu Sans", fontsize=9, color="#53647b"];
"users" [label="{users|PK id\lUQ normalized_email\lpassword_hash, role\l}"];
"airports" [label="{airports|PK id, UQ iata_code\lcity, zone_id\l}"];
"aircraft" [label="{aircraft|PK id, UQ registration\lmodel\l}"];
"aircraft_seats" [label="{aircraft_seats|PK id, FK aircraft_id\lseat_number, cabin, category\l}"];
"flights" [label="{flights|PK id, FK aircraft_id\lFK origin_id, destination_id\lflight_number, departure, arrival, status\l}"];
"flight_fares" [label="{flight_fares|PK id, FK flight_id\lcabin, fare_type, base_price, active\l}"];
"flight_seats" [label="{flight_seats|PK id, FK flight_id\lseat_number, cabin, category, status\lFK current_booking_id, hold_until\l}"];
"bookings" [label="{bookings|PK id, FK user_id, flight_id\lreference, client_request_id, request_hash\lstatus, hold_until, protected_until, total\loriginal_departure, refund_right_until, version\l}"];
"booking_passengers" [label="{booking_passengers|PK id, FK booking_id, flight_id\lFK flight_seat_id, flight_fare_id\lname, surname, birth_date, status\lcabin, fare_type, policy_version\l}"];
"booking_price_lines" [label="{booking_price_lines|PK id, FK passenger_id\lkind, amount, currency\lsnapshot_terms\l}"];
"payments" [label="{payments|PK id, FK booking_id\lidempotency_key, request_hash, status\lamount, gateway_reference, started_at\l}"];
"refunds" [label="{refunds|PK id, FK payment_id, booking_id\lFK passenger_id, reason\lamount, status, gateway_reference\l}"];
"tickets" [label="{tickets|PK id, UQ FK passenger_id\lUQ ticket_number, status\l}"];
"check_ins" [label="{check_ins|PK id, FK passenger_id\lUQ boarding_pass_id, status\l}"];
"notifications" [label="{notifications|PK id, FK user_id\levent_key, message, created_at, read_at\l}"];
"operation_requests" [label="{operation_requests|PK id, FK user_id\loperation, target_id, request_key\lpayload_hash, response_snapshot\l}"];
"simulated_charges" [label="{simulated_charges|PK operation_id\lamount, outcome, ready_at\l}"];
"simulated_refunds" [label="{simulated_refunds|PK operation_id\lFK charge_operation_id\lamount, outcome, ready_at\l}"];
"users" -> "bookings" [label="1 : N"];
"aircraft" -> "aircraft_seats" [label="1 : N"];
"aircraft" -> "flights" [label="1 : N"];
"airports" -> "flights" [label="1 : N origin / destination"];
"flights" -> "flight_fares" [label="1 : N"];
"flights" -> "flight_seats" [label="1 : N"];
"flights" -> "bookings" [label="1 : N"];
"bookings" -> "booking_passengers" [label="1 : 1..9"];
"flight_seats" -> "booking_passengers" [label="1 : N history; at most 1 ACTIVE"];
"flight_fares" -> "booking_passengers" [label="1 : N"];
"booking_passengers" -> "booking_price_lines" [label="1 : 3"];
"bookings" -> "payments" [label="1 : N attempts"];
"payments" -> "refunds" [label="1 : N"];
"booking_passengers" -> "refunds" [label="1 : N"];
"booking_passengers" -> "tickets" [label="1 : 0..1"];
"booking_passengers" -> "check_ins" [label="1 : N; at most 1 ACTIVE"];
"users" -> "notifications" [label="1 : N"];
"users" -> "operation_requests" [label="1 : N"];
"simulated_charges" -> "simulated_refunds" [label="1 : N"];
}
