digraph G {
graph [rankdir=LR, bgcolor="white", fontname="DejaVu Sans", fontsize=20, labelloc=t, nodesep=0.35, ranksep=0.8, label="Airline — domain classes and interfaces (revision 3)"];
node [shape=record, fontname="DejaVu Sans", fontsize=11, style=filled, fillcolor="#edf4ff", color="#5375a5", margin="0.12,0.08"];
edge [fontname="DejaVu Sans", fontsize=9, color="#53647b"];
"User" [label="{User|id, email, role\l}"];
"Airport" [label="{Airport|iataCode, zoneId\l}"];
"Aircraft" [label="{Aircraft|registration, model\l}"];
"AircraftSeat" [label="{AircraftSeat|seatNumber, cabin, category\l}"];
"Flight" [label="{Flight|number, departure, arrival, status\lreschedule(), transition(), cancel()\l}"];
"FlightFare" [label="{FlightFare|cabin, fareType, basePrice, active\l}"];
"FlightSeat" [label="{FlightSeat|status, bookingId, holdUntil\lhold(), book(), release(), block()\l}"];
"Booking" [label="{Booking|status, holdUntil, protectedUntil, total\lconfirm(), expire(), cancelPassengers()\l}"];
"BookingPassenger" [label="{BookingPassenger|name, birthDate, status, seatId\lcancel(), expire()\l}"];
"BookingPriceLine" [label="{BookingPriceLine|kind, amount, policy snapshot\l}"];
"Payment" [label="{Payment|status, idempotencyKey, amount\lsucceed(), fail()\l}"];
"Refund" [label="{Refund|reason, amount, status\lcomplete(), retry()\l}"];
"Ticket" [label="{Ticket|number, status\lvoidTicket(), close()\l}"];
"CheckIn" [label="{CheckIn|boardingPassId, status\linvalidate()\l}"];
"Notification" [label="{Notification|eventKey, message, readAt\l}"];
"Money" [label="{Money|BigDecimal amount, Currency KZT\ladd(), percentage()\l}"];
"PaymentGateway" [label="{PaymentGateway|interface\lcharge(), findCharge()\lrefund(), findRefund()\l}"];
"SimulatedPaymentGateway" [label="{SimulatedPaymentGateway|implements PaymentGateway\lpersisted operations\l}"];
"PaymentService" [label="{PaymentService|startPayment(), finalizePayment()\l}"];
"RefundPolicy" [label="{RefundPolicy|interface\lcalculateFareRefund()\l}"];
"BasicRefundPolicy" [label="{BasicRefundPolicy|implements RefundPolicy\l}"];
"FlexRefundPolicy" [label="{FlexRefundPolicy|implements RefundPolicy\l}"];
"RefundService" [label="{RefundService|reserve(), execute(), reconcile()\l}"];
"User" -> "Booking" [label="1 : 0..* owns"];
"Aircraft" -> "AircraftSeat" [label="1 : 1..* contains"];
"Flight" -> "Aircraft" [label="0..* : 1"];
"Flight" -> "Airport" [label="origin / destination"];
"Flight" -> "FlightFare" [label="1 : 1..*"];
"Flight" -> "FlightSeat" [label="1 : 1..* snapshot"];
"Booking" -> "Flight" [label="0..* : 1"];
"Booking" -> "BookingPassenger" [label="1 : 1..9 contains"];
"BookingPassenger" -> "FlightSeat" [label="historical assignment"];
"BookingPassenger" -> "FlightFare" [label="selected fare"];
"BookingPassenger" -> "BookingPriceLine" [label="1 : 3 snapshot"];
"Booking" -> "Payment" [label="1 : 0..* attempts"];
"Payment" -> "Refund" [label="1 : 0..*"];
"BookingPassenger" -> "Ticket" [label="1 : 0..1"];
"BookingPassenger" -> "CheckIn" [label="1 : 0..* history"];
"User" -> "Notification" [label="1 : 0..*"];
"BookingPriceLine" -> "Money" [label="value"];
"PaymentService" -> "PaymentGateway" [label="depends on"];
"SimulatedPaymentGateway" -> "PaymentGateway" [label="implements"];
"RefundService" -> "RefundPolicy" [label="depends on"];
"BasicRefundPolicy" -> "RefundPolicy" [label="implements"];
"FlexRefundPolicy" -> "RefundPolicy" [label="implements"];
}
